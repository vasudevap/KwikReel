# ---------------------------------------------------------------------------
# Media and personal data — NEVER COMMIT
#
# This project processes private family footage, frequently including children,
# with GPS trails showing where a family sleeps. Committing any of it is
# effectively irreversible: git history persists after deletion, and consent
# under ADR-002 is withdrawable, which a commit makes impossible to honour.
#
# Governed by ADR-002 (privacy and data posture).
# ---------------------------------------------------------------------------

# Source media, any location
*.mov
*.MOV
*.mp4
*.MP4
*.m4v
*.avi
*.hevc
*.heic
*.HEIC
*.jpg
*.jpeg
*.png
*.dng
*.raw

# Audio
*.wav
*.aac
*.m4a
*.mp3
*.flac

# Corpus, derivatives, and outputs
corpus/
media/
proxies/
keyframes/
renders/
output/
out/
*.proxy.*
draft*.mp4

# Prototype fixtures (ADR-013). Real-footage thumbnails/proxies stay ignored by the
# media globs above and MUST NOT be committed; only SYNTHETIC / rights-cleared assets
# (no real footage, no real people) are re-included under fixtures/synthetic/.
fixtures/local/
!fixtures/synthetic/
!fixtures/synthetic/**

# Consent records and identity mapping — PII, kept out of the repo entirely.
# The synthetic-ID mapping is the re-identification key for the whole corpus.
consent/
identity-map*
*-consent.*
subject-map*

# Annotations and ground truth (derived from private media)
annotations/
ground-truth/
labels/

# Held-out set — sealed until the final comparison (ADR-004)
held-out/

# Project state — canonical editor state under ADR-005.
# project.json embeds absolute paths to private media, source filenames, and
# capture metadata. It is per-user working state, never repository content.
project.json
*.project.json
projects/

# Run artifacts (results are summarized into records, not dumped here)
runs/
results/
*.analysis.json

# Superseded canonical output (ADR-001 -> ADR-005); retained so stale files
# from the pre-pivot design can never be committed either.
*.timeline.json

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
*.key
*.pem
credentials*
secrets*

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
node_modules/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# macOS
.DS_Store

# Claude Code — per-user local settings stay local; launch.json is shared
.claude/settings.local.json

# Design mockups — local only, deliberately never committed (2026-07-28).
# v3z and its 25 predecessors are the product's look and feel; they live on
# disk and are referenced by SPEC.md, but they are not in the public repo.
docs/design-claude/
docs/archive/design-claude/
mockups-antigravity/
mockups-codex/
